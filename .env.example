# Maximum number of conversations/facts/todos/Loop items printed per
# category when running with --include-content. Kept small by default so
# an opted-in content view stays a deliberate, glanceable snapshot.
LOOP_MAX_ITEMS=5

# IANA time zone override for `loops:check`'s deadline resolution ("today",
# "tomorrow", weekday names). Only needed if you want to force a zone other
# than Bee's own account time zone / your local system time zone (the
# defaults, checked in that order). Example: America/Los_Angeles
# LOOP_TIMEZONE=
