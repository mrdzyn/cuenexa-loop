# Base URL of the local Bee developer proxy (started with `bee proxy` after
# `bee login`). The proxy binds to 127.0.0.1 by default on port 8787; only
# override this if you started it on a different port.
BEE_PROXY_URL=http://127.0.0.1:8787

# Maximum number of conversations/facts/todos printed per category in the
# console output. Kept small by default so a run stays a deliberate,
# glanceable snapshot rather than a dump of everything Bee has captured.
LOOP_MAX_ITEMS=5
